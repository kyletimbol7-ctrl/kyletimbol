def iteration_loops():
    print("\n=====================================")
    print("|| LESSON 7: INTRODUCTION TO LOOPS ||")
    print("=====================================")

    print("""
Loops are used to repeat instructions
multiple times.

Types of Loops:

1. FOR LOOP
Repeats a block of code a specific
number of times.

2. WHILE LOOP
Repeats a block of code while a
condition is True.

3. BREAK
Stops the loop.

4. CONTINUE
Skips the current iteration.
""")

    print("\nFOR LOOP EXAMPLE")

    for number in range(1, 6):
        print("Number:", number)

    print("\nWHILE LOOP EXAMPLE")

    count = 1

    while count <= 5:
        print("Count:", count)
        count += 1

    print("\nBREAK STATEMENT EXAMPLE")

    for number in range(1, 6):
        if number == 4:
            break
        print(number)

    print("\nCONTINUE STATEMENT EXAMPLE")

    for number in range(1, 6):
        if number == 3:
            continue
        print(number)

    
    print("")  
    
